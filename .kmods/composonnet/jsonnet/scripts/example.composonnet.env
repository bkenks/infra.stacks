# Copy to .composonnet.env and edit. Read by src/jsonnet/scripts/render-compose.py.
# A real environment variable always wins over this file.

RENDER_COMPOSE_ROOT=/path/to/repo
RENDER_COMPOSE_SRC=/path/to/jsonnet/files               # relative to `RENDER_COMPOSE_ROOT`
RENDER_COMPOSE_JPATH=/path/to/lib:/path/to/other/lib    # relative to `RENDER_COMPOSE_ROOT`
