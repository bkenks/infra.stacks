# ============ Section: Start ============
# Gitea Production .env
#
# environment variables injected straight into the container's environment.
#
# LITERALS ONLY. Anything needing ${...} interpolation lives in
# ../compose/secrets.yml — a service env_file is not interpolated against the
# include's env_file scope, so ${...} here would resolve to an empty string.

USER_UID=   1000
USER_GID=   1000

# --- non-secret structural database config ---
GITEA__database__DB_TYPE=   postgres
GITEA__database__HOST=      db:5432
GITEA__SERVER__SSH_PORT=2222          # advertised in clone URLs
GITEA__SERVER__SSH_LISTEN_PORT=22     # what the container listens on (default)
GITEA__SERVER__SSH_DOMAIN=gitea.homektb.com

# Gitea Production .env
# ============  Section: End  =============
