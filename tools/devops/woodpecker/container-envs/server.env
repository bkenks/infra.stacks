# ============ Section: Start ============
# Woodpecker Server .env
#
# environment variables injected straight into the container's environment.
#
# LITERALS ONLY. Anything needing ${...} interpolation lives in
# ../compose/secrets.yml — a service env_file is not interpolated against the
# include's env_file scope, so ${...} here would resolve to an empty string.

# Public address of the server (scheme + host, no trailing slash). Used for
# OAuth redirects and webhook callbacks, so it must match the OAuth2 app's
# redirect URI in Forgejo: https://peck.homektb.com/authorize
WOODPECKER_HOST=https://peck.homektb.com

# Allow any Forgejo user to log in. Set to false + WOODPECKER_ADMIN=<forge-user>
# to lock the instance to named admins only.
WOODPECKER_OPEN=true

# --- Forge: self-hosted Forgejo (source-of-truth git forge) ---
WOODPECKER_FORGEJO=true
WOODPECKER_FORGEJO_URL=https://fj.homektb.com

# Plugins allowed to run privileged. The docker-buildx plugin runs
# Docker-in-Docker to build images, so it needs privileged mode. The match is
# exact INCLUDING the tag (a tag-less entry only matches :latest), so this must
# stay in lockstep with the plugin tag pinned in each pipeline's .woodpecker.yml.
WOODPECKER_PLUGINS_PRIVILEGED=woodpeckerci/plugin-docker-buildx:6.1.0

# Woodpecker Server .env
# ============  Section: End  =============
