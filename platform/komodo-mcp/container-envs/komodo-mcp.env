# ============ Section: Start ============
# komodo-mcp Production .env
#
# Environment variables injected straight into the container's environment.
#
# LITERALS ONLY. Anything needing ${...} interpolation lives in
# ../compose/secrets.yml — a service env_file is not interpolated against the
# include's env_file scope, so ${...} here would resolve to an empty string.

# Transport: streamable HTTP (listens on :8000 inside the container).
MCP_TRANSPORT=http

# Komodo Core API endpoint (behind this host's Traefik). Non-secret.
KOMODO_URL=https://komo.homektb.com
MCP_ALLOWED_HOSTS=komodo-mcp.homektb.com,komodo-mcp.lilbud.homektb.com
# Behind one reverse proxy (this host's Traefik). Trust the first hop so the
# server accepts X-Forwarded-* headers and resolves the real client IP.
MCP_TRUST_PROXY=1

# Timezone for log timestamps.
TZ=America/Chicago

# komodo-mcp Production .env
# ============  Section: End  =============
