# Names
POSTGRES__NAME=     "postgres"
REDIS__NAME=        "redis"
INFISICAL__NAME=    "infisical"

# Service-group identity — used for container network aliases (infisical-app/-db/-redis).
SERVICE_NAME=       "infisical"

# DB Login
INFISICAL__POSTGRES_USER=    infisical
INFISICAL__POSTGRES_DBNAME=  infisical

# Site
INFISICAL__SITE_URL=    https://infisical.homektb.com

# Container Restart Attempts On Failure (Exit Error)
INFISICAL__MAX_RESTART_ATTEMPS=  5
POSTGRES__MAX_RESTART_ATTEMPS=   5
REDIS__MAX_RESTART_ATTEMPS=      5

