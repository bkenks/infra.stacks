# platform/base project env. These are DEFAULTS for a plain `docker compose`
# run; infra.ansible (cold bootstrap) and Komodo (steady state) override them
# per host. Secrets (INFISICAL_CLIENT_ID/SECRET) are NEVER committed — they come
# from Komodo per-server variables or Ansible vault at deploy time.

# Deploy mode -> selects which services start (and which agent variant runs:
# the control-plane profile uses the in-project Infisical address, node the
# public URL). node | control-plane (+ bootstrap gates: restore, identity).
COMPOSE_PROFILES=node

# Infisical-agent knobs (see services/infisical-agent).
#   AGENT_HOST       this host's name (drives ${AGENT_HOST} secret-path subs)
#   AGENT_SERVICES   comma/space list of services to render (services/infisical-agent/files/services.tab)
AGENT_HOST=changeme
AGENT_SERVICES=traefik,cloudflared,zerobyte,databasus
