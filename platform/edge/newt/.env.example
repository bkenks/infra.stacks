# Rendered to /dev/shm/newt.env by the infisical-agent (Infisical project
# "infra", folder /roles/traefik-controller, env "prod" — see
# .jsonnet/lib/registry.libsonnet agentServices.newt). Never fill in real
# values here — this file just documents which keys must exist in Infisical.
#
# Role-scoped, NOT host-scoped: any host that takes on the traefik-controller
# role opts this service in (AGENT_SERVICES) and pulls the same credentials.
# Both keys come from Pangolin when you create the site.

# Newt site ID (Pangolin -> Sites -> create).
NEWT_ID=

# Newt site secret (shown once at site creation).
NEWT_SECRET=
