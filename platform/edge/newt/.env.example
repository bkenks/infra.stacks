# Rendered to /dev/shm/newt.env by the infisical-agent (Infisical project
# "infra", folder /roles/${AGENT_ROLE}/newt, env "prod" — see
# .jsonnet/lib/registry.libsonnet agentServices.newt). Never fill in real
# values here — this file just documents which keys must exist in Infisical.
#
# Role-scoped, NOT host-scoped: the folder is parameterized by the host's role
# (AGENT_ROLE), the mirror of how cloudflared uses AGENT_HOST. A host running
# the traefik-controller role sets AGENT_ROLE=traefik-controller, so this
# resolves to /roles/traefik-controller/newt. Both keys come from Pangolin when
# you create the site.

# Newt site ID (Pangolin -> Sites -> create).
NEWT_ID=

# Newt site secret (shown once at site creation).
NEWT_SECRET=
