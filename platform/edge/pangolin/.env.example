# Rendered to /dev/shm/pangolin.env by the infisical-agent (Infisical project
# "apps", folder /pangolin, env "prod" — see .jsonnet/lib/registry.libsonnet
# agentServices.pangolin). Never fill in real values here — this file just
# documents which keys must exist in Infisical.

# Pangolin's session/crypto secret (server.secret in config.yml). Generate
# with: openssl rand -base64 32
SERVER_SECRET=

# Resend SMTP API key used as email.smtp_pass in config.yml.
EMAIL_SMTP_PASS=
