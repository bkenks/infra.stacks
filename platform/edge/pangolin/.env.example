# Rendered to /dev/shm/pangolin.env by the infisical-agent (Infisical project
# "apps", folder /pangolin, env "prod" — see .jsonnet/lib/registry.libsonnet
# agentServices.pangolin). Never fill in real values here — this file just
# documents which keys must exist in Infisical.

# Pangolin's session/crypto secret (server.secret in config.jsonnet). Generate
# with: openssl rand -base64 32
SERVER_SECRET=

# Resend SMTP API key used as email.smtp_pass in config.jsonnet.
EMAIL_SMTP_PASS=

# CF_DNS_API_TOKEN (Traefik's Cloudflare DNS-01 challenge) is NOT rendered
# here — it comes from the separate, shared /dev/shm/cloudflare__dns-api-token.env
# (Infisical folder /traefik, project infra, registry key
# agentServices.'cloudflare__dns-api-token'), also used by platform/edge/traefik.
# Nothing to add for it in the /pangolin folder.
