# authentik — secret reference (EXAMPLE ONLY, never commit real values).
#
#
# Infisical key  ->  container env var(s)          (folder: infra:/authentik)
# ------------------------------------------------------------------------------
# AUTHENTIK_SECRET_KEY  ->  AUTHENTIK_SECRET_KEY    # Django secret key (50+ random chars)
# PG_PASS               ->  AUTHENTIK_POSTGRESQL__PASSWORD, POSTGRES_PASSWORD
# BOOTSTRAP_PASSWORD    ->  AUTHENTIK_BOOTSTRAP_PASSWORD   # initial akadmin password
# BOOTSTRAP_TOKEN       ->  AUTHENTIK_BOOTSTRAP_TOKEN      # initial API token (provisions outpost)
# BOOTSTRAP_EMAIL       ->  AUTHENTIK_BOOTSTRAP_EMAIL      # initial akadmin email
#
# Generate strong values, e.g.:
#   openssl rand -base64 60   # AUTHENTIK_SECRET_KEY
#   openssl rand -base64 36   # PG_PASS / BOOTSTRAP_PASSWORD / BOOTSTRAP_TOKEN

AUTHENTIK_SECRET_KEY=replace-me
PG_PASS=replace-me
BOOTSTRAP_PASSWORD=replace-me
BOOTSTRAP_TOKEN=replace-me
BOOTSTRAP_EMAIL=admin@ktbcloud.com
