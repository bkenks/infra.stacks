# Names (also select the matching container-envs/<name>.env files)
POSTGRES__NAME=     "postgres"
GITEA__NAME=        "gitea"

# DB Login (non-secret; the password is the secret in /dev/shm/gitea.env)
GITEA__POSTGRES_USER=       gitea
GITEA__POSTGRES_DBNAME=     gitea

# Container Restart Attempts On Failure (Exit Error)
GITEA__MAX_RESTART_ATTEMPS=     5
POSTGRES__MAX_RESTART_ATTEMPS=  5
