# grist — secret reference (EXAMPLE ONLY, never commit real values).
#
# Infisical key  ->  container env var          (folder: infra:/grist)
# ------------------------------------------------------------------------------
# GRIST_SESSION_SECRET  ->  GRIST_SESSION_SECRET   # signs sessions; keep stable across restarts
#
# Generate a strong value, e.g.:
#   openssl rand -base64 48   # GRIST_SESSION_SECRET

GRIST_SESSION_SECRET=replace-me
