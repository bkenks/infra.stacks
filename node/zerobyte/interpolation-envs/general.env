# Values used purely for ${...} interpolation in the compose body
# (compose/stack.yml + compose/secrets.yml). NOT injected into the container —
# that's what container-envs/zerobyte.env is for.

# Name (also selects the matching container-envs/<name>.env)
ZEROBYTE__NAME=                 "zerobyte"

# Base domain for the per-host dotted router. The host's Traefik serves
# zerobyte.<host>.homektb.com from its *.<host>.homektb.com wildcard cert.
ZEROBYTE__BASE_DOMAIN=          homektb.com

# Dotted host token — OVERRIDDEN PER-SERVER in Komodo (lilbud, maboi, paiki).
# Produces the router host zerobyte.<token>.homektb.com and BASE_URL. No safe
# shared default, so it is intentionally empty (:?err) to force a per-server set.
ZEROBYTE__HOST=

# Web UI port (internal — Traefik routes to it; not published on the host)
ZEROBYTE__PORT=                 4096

# Container restart attempts on failure (exit error)
ZEROBYTE__MAX_RESTART_ATTEMPS=  5
