# Values used purely for ${...} interpolation in the compose body
# (compose/stack.yml + compose/secrets.yml). NOT injected into the container —
# that's what container-envs/zerobyte.env is for.

# Name (also selects the matching container-envs/<name>.env)
ZEROBYTE__NAME=                 "zerobyte"

# App's own public URL (links/redirects) — OVERRIDDEN PER-SERVER in Komodo.
# zerobyte no longer uses Traefik; it's reached directly by host / Tailscale IP,
# so set this to that URL, e.g. http://<tailscale-ip>:4096. No safe shared
# default, so it is intentionally empty (:?err) to force a per-server set.
ZEROBYTE__BASE_URL=

# Web UI port — PUBLISHED on the host (no Traefik). Reach it at <host-ip>:<port>.
ZEROBYTE__PORT=                 4096

# Container restart attempts on failure (exit error)
ZEROBYTE__MAX_RESTART_ATTEMPS=  5
