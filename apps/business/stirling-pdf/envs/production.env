# =====================================================
# App Configuration
# =====================================================
# --- Static ---
# Built-in user accounts. On first boot Stirling seeds an admin as
# admin/stirling -- change it immediately in Settings -> Account.
# The user database lives in the persisted /configs volume.
SECURITY_ENABLELOGIN=true

# UI language(s) offered in the language picker.
LANGS=en_US
# --- END "Static" ---


# --- Injected ---
# --- END "Injected" ---


# --- Inactive ---
# To seed admin credentials instead of the admin/stirling default, set:
#   SECURITY_INITIALLOGIN_USERNAME / SECURITY_INITIALLOGIN_PASSWORD
# (treat the password as a secret -> bs3 vault -> ${VAR:?err} above).
# --- END "Inactive" ---
# =====================================================
# END "App Configuration"
# =====================================================
