DOCKER_ENVIRONMENT=production




# =====================================================
# Postgres Connection
# =====================================================
POSTGRES_PORT=5432
POSTGRES_HOST_CONTAINER=postgres-${DOCKER_ENVIRONMENT}-db
POSTGRES_DB_NAME=n8n
# =====================================================
# END "Postgres Connection"
# =====================================================




# =====================================================
# App Configuration
# =====================================================
# --- Static ---
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_RUNNERS_ENABLED=true
NODE_ENV=production
N8N_PROXY_HOPS=1
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

WEBHOOK_URL=https://n8n.homektb.com/
N8N_HOST=n8n.homektb.com

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${POSTGRES_HOST_CONTAINER}
DB_POSTGRESDB_PORT=${POSTGRES_PORT}
DB_POSTGRESDB_DATABASE=${POSTGRES_DB_NAME}
DB_POSTGRESDB_SCHEMA=public
# --- END "Static" ---


# --- Injected ---
DB_POSTGRESDB_USER=${POSTGRES_USER:?err}
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASS:?err}
# --- END "Injected" ---
# =====================================================
# END "App Configuration"
# =====================================================
