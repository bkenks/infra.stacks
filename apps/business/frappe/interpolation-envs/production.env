# Production version pins.
#
# FRAPPE__IMAGE_TAG tracks the Frappe/ERPNext/HR branch baked into the GHCR
# image (image/apps.json). The image build publishes a moving `version-15` tag
# plus an immutable `version-15-<sha>` tag. For maximum reproducibility in
# production, pin the immutable one here and bump deliberately.
FRAPPE__IMAGE_TAG=  version-15

# MariaDB 10.6 is the long-proven pairing for Frappe v15. 11.x also works.
MARIADB__VERS_TAG=   10.6

REDIS__VERS_TAG=     7-alpine
