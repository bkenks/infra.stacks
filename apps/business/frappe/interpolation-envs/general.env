# Non-secret interpolation values shared across environments.
# Naming convention: SERVICE__VAR (double underscore), matching stack.infra.

# --- Custom image (built from image/apps.json -> GHCR; see image/README.md) ---
FRAPPE__IMAGE=         ghcr.io/ktbgroup-self-hosted/frappe
FRAPPE__PULL_POLICY=   always

# --- Traefik routing -------------------------------------------------------
# List EVERY site this bench serves. Add a Host() clause each time you create a
# new tenant site, then redeploy so Traefik picks up the new rule.
#   Host(`erp.homektb.com`) || Host(`client-a.com`) || Host(`client-b.com`)
FRAPPE__SITES_RULE=    Host(`business.stackform.app`)

# --- Container restart attempts on failure ---------------------------------
FRAPPE__MAX_RESTART_ATTEMPS=  5
MARIADB__MAX_RESTART_ATTEMPS=  5
REDIS__MAX_RESTART_ATTEMPS=    5
