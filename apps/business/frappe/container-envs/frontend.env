# ============ Section: Start ============
# frontend (nginx) container env — LITERALS ONLY.
#
# FRAPPE_SITE_NAME_HEADER makes nginx pass the inbound Host header to Frappe as
# the site selector — this is what drives DNS-based multitenancy. nginx-entrypoint.sh
# expands $host at request time. Compose interpolates env_file values, so the
# literal $host MUST be escaped here as $$host (else it resolves to empty and ALL
# routing breaks). Do NOT set this to a fixed site name, or all traffic routes to
# that one site.

BACKEND=                     backend:8000
SOCKETIO=                    websocket:9000
FRAPPE_SITE_NAME_HEADER=     $$host

# Traefik terminates TLS and forwards over the proxy network; trust its range so
# Frappe logs the real client IP. 172.16.0.0/12 covers Docker bridge networks.
UPSTREAM_REAL_IP_ADDRESS=    172.16.0.0/12
UPSTREAM_REAL_IP_HEADER=     X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=  on

PROXY_READ_TIMEOUT=          120
CLIENT_MAX_BODY_SIZE=        50m

# ============  Section: End  =============
