# ============ Section: Start ============
# configurator container env — LITERALS ONLY.
#
# Read by the configurator's command, which writes these into
# common_site_config.json on the shared sites volume. All values are internal
# service addresses (non-secret), so they live here rather than in secrets.yml.

DB_HOST=        db
DB_PORT=        3306
REDIS_CACHE=    redis-cache:6379
REDIS_QUEUE=    redis-queue:6379
SOCKETIO_PORT=  9000

# ============  Section: End  =============
