# Values used purely for ${...} interpolation in the compose body
# (yamls/stack.yaml + yamls/secrets.yaml). NOT injected into containers —
# that's what container-envs/*.env is for.

# Names (also select the matching container-envs/<name>.env files)
APP__NAME=  "openproject"

# Image version tags (pin them; avoid `latest`)
# openproject/openproject — cron, seeder, web, worker
APP__VERSION=         "17-slim"
# openproject/hocuspocus
HOCUSPOCUS__VERSION=  "17.1.2"
# willfarrell/autoheal
AUTOHEAL__VERSION=    "1.2.0"
