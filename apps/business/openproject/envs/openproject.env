# =====================================================
# Postgres Connection
# =====================================================
POSTGRES_PORT=5432
POSTGRES_HOST_CONTAINER=postgres-${DOCKER_ENVIRONMENT}-db
POSTGRES_DB_NAME=openproject
POSTGRES_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASS}@${POSTGRES_HOST_CONTAINER}:${POSTGRES_PORT}/${POSTGRES_DB_NAME}
# POSTGRES_URL=postgres://postgres.${POSTGRES_TENANT_ID}:${POSTGRES_PASS}@${POSTGRES_HOST_CONTAINER}:5432/postgres
# =====================================================
# END "Postgres Connection"
# =====================================================




# =====================================================
# App Configuration
# =====================================================
# --- Static ---
OPENPROJECT_HTTPS=true
OPENPROJECT_HSTS=true
OPENPROJECT_RAILS__RELATIVE__URL__ROOT=
# Responsible for editing documents in projects. "wss" for secure websocket since it's proxied
# and using ROOT_DOMAIN since DOMAIN isn't defined until later in the env
OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__URL=wss://openprj.${ROOT_DOMAIN}/hocuspocus

IMAP_ENABLED=false
RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16
OPENPROJECT_RAILS__CACHE__STORE=memcache
OPENPROJECT_CACHE__MEMCACHE__SERVER=cache:11211

AUTOHEAL_CONTAINER_LABEL=autoheal
AUTOHEAL_START_PERIOD=600
AUTOHEAL_INTERVAL=30

# Visuals
OPENPROJECT_EE__HIDE__BANNERS=true
OPENPROJECT_EE__MANAGER__VISIBLE=false
OPENPROJECT_WELCOME__ON__HOMESCREEN=false
OPENPROJECT_DISABLED__MODULES=
# --- END "Static" ---


# --- Interpolated ---
DOMAIN=openprj.${ROOT_DOMAIN}
OPENPROJECT_HOST__NAME=${DOMAIN}
OPENPROJECT_ADDITIONAL__HOST__NAMES=${DOMAIN}
OPENPROJECT_URL=https://${DOMAIN}
# --- END "Interpolated" ---


# --- Injected ---
ROOT_DOMAIN=${ROOT_DOMAIN:?err}
POSTGRES_USER=${POSTGRES_USER:?err}
POSTGRES_PASS=${POSTGRES_PASS:?err}
DATABASE_URL=${POSTGRES_URL:?err}
SECRET_KEY_BASE=${OPEN_PRJ_SECRET_KEY:?err}
OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__SECRET=${COLLAB_SERVER_SECRET:?err}
SECRET=${COLLAB_SERVER_SECRET:?err}
# --- END "Injected" ---


# --- Inactive ---
# OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__URL: wss://${DOMAIN}/hocuspocus
# --- END "Inactive" ---
# =====================================================
# END "App Configuration"
# =====================================================
