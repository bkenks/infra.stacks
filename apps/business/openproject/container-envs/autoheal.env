# ============ Section: Start ============
# autoheal sidecar (willfarrell/autoheal) — literal config.
# Restarts containers labelled `autoheal=true` (see the web service).

AUTOHEAL_CONTAINER_LABEL=autoheal
AUTOHEAL_START_PERIOD=600
AUTOHEAL_INTERVAL=30

# autoheal sidecar
# ============  Section: End  =============
