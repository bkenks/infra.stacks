# ============ Section: Start ============
# openproject Production .env
#
# environment variables injected straight into the container's environment.
#
# LITERALS ONLY. Anything needing ${...} interpolation lives in
# ../yamls/secrets.yaml — a service env_file is not interpolated against the
# include's env_file scope, so ${...} here would resolve to an empty string.

# --- HTTP / Rails ---
OPENPROJECT_HTTPS=true
OPENPROJECT_HSTS=true
OPENPROJECT_RAILS__RELATIVE__URL__ROOT=
RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16
IMAP_ENABLED=false

# --- Host / URLs ---
OPENPROJECT_HOST__NAME=openprj.homektb.com
# `web` allows hocuspocus' internal callback (http://web:8080) to pass the host check
OPENPROJECT_ADDITIONAL__HOST__NAMES=openprj.homektb.com,web
OPENPROJECT_URL=https://openprj.homektb.com
# "wss" for secure websocket since the collab server is proxied behind TLS
OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__URL=wss://openprj.homektb.com/hocuspocus

# --- Cache (memcached sidecar) ---
OPENPROJECT_RAILS__CACHE__STORE=memcache
OPENPROJECT_CACHE__MEMCACHE__SERVER=cache:11211

# --- Visuals ---
OPENPROJECT_EE__HIDE__BANNERS=true
OPENPROJECT_EE__MANAGER__VISIBLE=false
OPENPROJECT_WELCOME__ON__HOMESCREEN=false
OPENPROJECT_DISABLED__MODULES=

# openproject Production .env
# ============  Section: End  =============
