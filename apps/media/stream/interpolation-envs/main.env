# Values used purely for ${...} interpolation in the compose body
# (compose/stack.yaml). NOT injected into containers — that's what
# container-envs/*.env is for.

# ── Host data path ───────────────────────────────────────────────────────────
# Base path for this stack's bind-mounted data (per-app config + the shared
# media/usenet library). REQUIRED — there is intentionally no default: a wrong
# value would mount empty dirs and the apps would re-initialise with lost state.
# Set it to the host's media-volumes base (it must already contain
# stream/{plex,sonarr,...}/config and stream/shared/{media,usenet}).
# Provide it here OR in the host/Komodo environment.
# DOCKER_VOLUMES=/path/on/host

# ── Names (also select the matching container-envs/<name>.env files) ─────────
PLEX__NAME=       "plex"
SEERR__NAME=      "seerr"
PROWLARR__NAME=   "prowlarr"
BAZARR__NAME=     "bazarr"
SABNZBD__NAME=    "sabnzbd"
RADARR__NAME=     "radarr"
SONARR__NAME=     "sonarr"
CONFIGARR__NAME=  "configarr"
DECLUTTARR__NAME= "decluttarr"

# ── Image pins ───────────────────────────────────────────────────────────────
# Tag-pinned (image:${...VERS_TAG})
PLEX__VERS_TAG=       1.42.2
SEERR__VERS_TAG=      v3.0.1
BAZARR__VERS_TAG=     1.5.4
CONFIGARR__VERS_TAG=  1.28.0
DECLUTTARR__VERS_TAG= v2.1.0
# Digest-pinned (image@${...DIGEST}) — kept exactly as before for reproducibility
PROWLARR__DIGEST=  sha256:d3e9307b320b6772749a2cf8fc2712e9e824c4930b034680ad4d08a9e2f25884
SABNZBD__DIGEST=   sha256:fba727f777f6b2633fcdeaea94abc85d73148f2a6b19a8158907bdd5b6e145d0
RADARR__DIGEST=    sha256:270f25698624b57b86ca119cc95399d7ff15be8297095b4e1223fd5b549b732c
SONARR__DIGEST=    sha256:02b4d538d351d6e35882a021c08e8600fe95d28860fb1dd724b597166e7221ca

# ── Container Restart Attempts On Failure (Exit Error) ───────────────────────
PLEX__MAX_RESTART_ATTEMPS=       5
SEERR__MAX_RESTART_ATTEMPS=      5
PROWLARR__MAX_RESTART_ATTEMPS=   5
BAZARR__MAX_RESTART_ATTEMPS=     5
SABNZBD__MAX_RESTART_ATTEMPS=    5
RADARR__MAX_RESTART_ATTEMPS=     5
SONARR__MAX_RESTART_ATTEMPS=     5
CONFIGARR__MAX_RESTART_ATTEMPS=  5
DECLUTTARR__MAX_RESTART_ATTEMPS= 5
