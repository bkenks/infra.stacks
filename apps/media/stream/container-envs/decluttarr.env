# ============ Section: Start ============
# Decluttarr Production .env  —  LITERALS ONLY.
#
# Decluttarr is a long-running queue janitor. Its behaviour (jobs, timers,
# strikes, the Sonarr/Radarr instances) is config-as-code in
# ../decluttarr/config.yaml. The SONARR_API_KEY / RADARR_API_KEY it reads via
# `!ENV` are NOT here (they're secrets) — they're rendered to /dev/shm/stream.env
# by the infisical-agent and fed in via compose/secrets.yaml.

PUID=1000
PGID=1000
TZ=America/New_York

# Decluttarr Production .env
# ============  Section: End  =============
