# ============ Section: Start ============
# Configarr Production .env  —  LITERALS ONLY.
#
# Configarr is a one-shot job: on each deploy it syncs TRaSH-guide quality
# profiles + custom formats (defined as code in ../configarr/config.yml) into
# Sonarr and Radarr, then exits 0. The SONARR_API_KEY / RADARR_API_KEY it needs
# are NOT here (they're secrets) — they're rendered to /dev/shm/stream.env by the
# infisical-agent and fed into the container via compose/secrets.yaml + `!env`.

PUID=1000
PGID=1000
TZ=America/New_York

# Configarr Production .env
# ============  Section: End  =============
