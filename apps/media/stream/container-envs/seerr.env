# ============ Section: Start ============
# Seer Production .env  —  LITERALS ONLY.
# Seer (ghcr.io/seerr-team/seerr) runs as the fixed non-root `node` user and
# ignores PUID/PGID; it only needs TZ (and serves on 5055 by default). The host
# config dir must be owned 1000:1000 — see setup.md.

TZ=America/New_York

# Seer Production .env
# ============  Section: End  =============
