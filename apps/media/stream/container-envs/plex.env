# ============ Section: Start ============
# Plex Production .env  —  LITERALS ONLY (see template: ${...} goes in
# compose/secrets.yaml, which this stack doesn't have).

# Run as root, preserving prior behaviour (config dir is root-owned).
PUID=0
PGID=0
# linuxserver/plex update channel ("docker" = pinned-by-image, no in-container update).
VERSION=docker

# PLEX_CLAIM is only needed for the very first server claim (plex.tv/claim).
# It's effectively a short-lived secret — uncomment, paste the token, claim
# once, then re-comment. (If you'd rather not put it in-repo, set it via the
# host/Komodo env instead.)
# PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx

# Plex Production .env
# ============  Section: End  =============
