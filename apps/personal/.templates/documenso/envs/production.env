DOCKER_ENVIRONMENT=production




# =====================================================
# Postgres Connection
# =====================================================
POSTGRES_PORT=5432
POSTGRES_HOST_CONTAINER=postgres-${DOCKER_ENVIRONMENT}-db
POSTGRES_DB_NAME=documenso
POSTGRES_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASS}@${POSTGRES_HOST_CONTAINER}:${POSTGRES_PORT}/${POSTGRES_DB_NAME}
# =====================================================
# END "Postgres Connection"
# =====================================================




# =====================================================
# App Configuration
# =====================================================
# --- Static ---
PORT=3000

NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=/opt/documenso/cert.p12
NEXT_PUBLIC_WEBAPP_URL=https://documenso.homektb.com
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3000


# Email configuration
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=smtp.gmail.com
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_FROM_NAME=Documenso
NEXT_PRIVATE_SMTP_FROM_ADDRESS="briankenkel.t@gmail.com"

# Disable public signups
NEXT_PUBLIC_DISABLE_SIGNUP=true
# --- END "Static" ---


# --- Injected ---
NEXTAUTH_SECRET=${NEXTAUTH_SECRET:?err}
NEXT_PRIVATE_ENCRYPTION_KEY=${NEXT_PRIVATE_ENCRYPTION_KEY:?err}
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=${NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY:?err}
POSTGRES_USER=${POSTGRES_USER:?err}
POSTGRES_PASSWORD=${POSTGRES_PASS:?err}
NEXT_PRIVATE_DATABASE_URL=${POSTGRES_URL:?err}
NEXT_PRIVATE_DIRECT_DATABASE_URL=${POSTGRES_URL:?err}
NEXT_PRIVATE_SIGNING_PASSPHRASE=${NEXT_PRIVATE_SIGNING_PASSPHRASE:?err}
NEXT_PRIVATE_SMTP_USERNAME=${SMTP_USER:?err}
NEXT_PRIVATE_SMTP_PASSWORD=${SMTP_PASS:?err}
# --- END "Injected" ---


