# =====================================================
# App Configuration
# =====================================================
# --- Static ---
# Budibase self-hosting. The proxy is published on host port 10000. CouchDB / Minio / Redis are
# internal-only. CouchDB user is fixed; its password is injected below.
BUDIBASE_ENVIRONMENT=PRODUCTION
COUCH_DB_USER=budibase
COUCH_DB_USERNAME=budibase
COUCHDB_USER=budibase
# --- END "Static" ---


# --- Injected ---
API_ENCRYPTION_KEY=${BUDIBASE_API_ENCRYPTION_KEY:?err}
JWT_SECRET=${BUDIBASE_JWT_SECRET:?err}
INTERNAL_API_KEY=${BUDIBASE_INTERNAL_API_KEY:?err}
COUCH_DB_PASSWORD=${BUDIBASE_COUCH_DB_PASSWORD:?err}
COUCHDB_PASSWORD=${BUDIBASE_COUCH_DB_PASSWORD:?err}
COUCH_DB_URL=http://budibase:${BUDIBASE_COUCH_DB_PASSWORD:?err}@couchdb-service:5984
REDIS_PASSWORD=${BUDIBASE_REDIS_PASSWORD:?err}
MINIO_ACCESS_KEY=${BUDIBASE_MINIO_ACCESS_KEY:?err}
MINIO_SECRET_KEY=${BUDIBASE_MINIO_SECRET_KEY:?err}
MINIO_ROOT_USER=${BUDIBASE_MINIO_ACCESS_KEY:?err}
MINIO_ROOT_PASSWORD=${BUDIBASE_MINIO_SECRET_KEY:?err}
# --- END "Injected" ---


# --- Inactive ---
# Auto-create an initial admin account on first boot. If left unset, create
# the admin in the browser on first visit instead.
# BB_ADMIN_USER_EMAIL=${BUDIBASE_ADMIN_EMAIL}
# BB_ADMIN_USER_PASSWORD=${BUDIBASE_ADMIN_PASSWORD}
# --- END "Inactive" ---
# =====================================================
# END "App Configuration"
# =====================================================
