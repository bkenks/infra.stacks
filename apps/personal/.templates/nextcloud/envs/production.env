DOCKER_ENVIRONMENT=production


# =====================================================
# Reverse Proxy Configuration
# =====================================================
# Port that the AIO-managed Nextcloud Apache container binds to on the host.
# Must match the port your reverse proxy (Caddy) forwards traffic to.
APACHE_PORT=11000
APACHE_IP_BINDING=0.0.0.0
# =====================================================
# END "Reverse Proxy Configuration"
# =====================================================


# =====================================================
# App Configuration
# =====================================================
# --- Static ---
# Max upload size for files
NEXTCLOUD_UPLOAD_LIMIT=10G

# Max execution time for long operations (e.g. large uploads)
NEXTCLOUD_MAX_TIME=3600

# PHP memory limit
NEXTCLOUD_MEMORY_LIMIT=512M
# --- END "Static" ---


# --- Inactive ---
# Override the default Nextcloud data directory (must be an absolute path)
# NEXTCLOUD_DATADIR=/mnt/data/nextcloud

# Trusted SSL certificate authorities directory
# NEXTCLOUD_TRUSTED_CACERTS_DIR=/path/to/certs

# Skip domain validation check on first setup (not recommended)
# SKIP_DOMAIN_VALIDATION=false
# --- END "Inactive" ---
# =====================================================
# END "App Configuration"
# =====================================================
