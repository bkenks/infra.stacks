# ============ Section: Start ============
# Scriberr Production .env
#
# environment variables injected straight into the container.
#
# LITERALS ONLY. Anything needing ${...} interpolation would live in
# ../compose/secrets.yml — a service env_file is not interpolated against the
# include's env_file scope, so ${...} here would resolve to an empty string.
# Scriberr has no required secrets, so there is no secrets.yml.

# APP_ENV must be `production` in Docker — DO NOT CHANGE.
APP_ENV=          production

# Host UID/GID for volume permissions (avoids SQLite permission errors).
PUID=             1000
PGID=             1000

# CORS: comma-separated allowed origins. Served over HTTPS via Traefik, so
# SECURE_COOKIES stays at its production default (true) — do not set it false.
ALLOWED_ORIGINS=  https://scriberr.homektb.com

# Optional: uncomment to enable the in-app LLM chat feature.
# OPENAI_API_KEY=

# Scriberr Production .env
# ============  Section: End  =============
