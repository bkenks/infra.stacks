# ============ Section: Start ============
# Paperless-ngx Production .env
#
# environment variables injected straight into the webserver container.
#
# LITERALS ONLY. Anything needing ${...} interpolation lives in
# ../compose/secrets.yml — a service env_file is not interpolated against the
# include's env_file scope, so ${...} here would resolve to an empty string.

# --- Document processing ---
PAPERLESS_TIKA_ENABLED=             1
PAPERLESS_OCR_LANGUAGE=             eng

# --- Locale ---
PAPERLESS_URL=                      https://paper.homektb.com
PAPERLESS_TIME_ZONE=                America/New_York
PAPERLESS_DATE_ORDER=               MDY

# --- Service endpoints (reached by compose service name on the default net) ---
PAPERLESS_REDIS=                    redis://broker:6379
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=  http://gotenberg:3000
PAPERLESS_TIKA_ENDPOINT=            http://tika:9998

# --- Non-secret structural database config ---
PAPERLESS_DBHOST=                   db

# Paperless-ngx Production .env
# ============  Section: End  =============
