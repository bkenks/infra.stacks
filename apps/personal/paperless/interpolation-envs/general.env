# Names (also select the matching container-envs/<name>.env files)
PAPERLESS__NAME=    "paperless"
POSTGRES__NAME=     "postgres"
REDIS__NAME=        "redis"

# DB Login (non-secret; the password is the secret in /dev/shm/apps_paperless.env)
PAPERLESS__POSTGRES_USER=    paperless
PAPERLESS__POSTGRES_DBNAME=  paperless

# Container Restart Attempts On Failure (Exit Error)
PAPERLESS__MAX_RESTART_ATTEMPS=  5
POSTGRES__MAX_RESTART_ATTEMPS=   5
REDIS__MAX_RESTART_ATTEMPS=      5
GOTENBERG__MAX_RESTART_ATTEMPS=  5
TIKA__MAX_RESTART_ATTEMPS=       5
