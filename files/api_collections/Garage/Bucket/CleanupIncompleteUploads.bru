meta {
  name: CleanupIncompleteUploads
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v2/CleanupIncompleteUploads
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "bucketId": "",
    "olderThanSecs": 0
  }
}

docs {
  # CleanupIncompleteUploads

  `POST /v2/CleanupIncompleteUploads`

  Removes all incomplete multipart uploads that are older than the specified number of seconds.
}
