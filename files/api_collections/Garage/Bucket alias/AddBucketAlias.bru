meta {
  name: AddBucketAlias
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v2/AddBucketAlias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "bucketId": "",
    "globalAlias": ""
  }
}

docs {
  # AddBucketAlias

  `POST /v2/AddBucketAlias`

  Add an alias for the target bucket.  This can be either a global or a local alias, depending on which fields are specified.
}
