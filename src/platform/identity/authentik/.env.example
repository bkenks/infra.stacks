# authentik — secret reference (EXAMPLE ONLY, never commit real values).
#
# Infisical key          ->  container env var        (project: infra, folder: /authentik)
# ------------------------------------------------------------------------------
# AUTHENTIK_SECRET_KEY    ->  AUTHENTIK_SECRET_KEY     # signs sessions/tokens; keep STABLE forever
# AUTHENTIK_PG_PASS       ->  AUTHENTIK_PG_PASS        # Postgres password (bundled db + server + worker)
#
# Generate strong values, e.g.:
#   openssl rand -base64 60 | tr -d '\n'   # AUTHENTIK_SECRET_KEY
#   openssl rand -base64 36 | tr -d '\n'   # AUTHENTIK_PG_PASS
#
# Set both in Infisical (infra:/authentik) BEFORE the first deploy — the compose uses
# ${VAR:?err}, so a missing value aborts the deploy.

AUTHENTIK_SECRET_KEY=replace-me
AUTHENTIK_PG_PASS=replace-me
