// The tailnet gateway every stack that needs one attaches to. This stack owns the shared
// network; consumers attach to it.
amends "@infra/Stack.pkl"

import "@infra/registry.pkl"
import "@infra/secrets.pkl"

local appVersion = "v1.102.3"
local gateway = registry.network.shared.tailscale_gw_001

name = "tailscale-gw"

services {
  ["secrets"] = secrets.fnox

  ["app"] {
    image = "tailscale/tailscale:\(appVersion)"
    restart = "unless-stopped"
    depends_on = secrets.ready
    networks { "default"; gateway.name }
    data { ["state"] { target = "/var/lib/tailscale" } }
    // TS_AUTHKEY arrives from 1Password through fnox. HOST is not a secret: it comes from the
    // deploy environment, so compose still interpolates it here.
    environment {
      // Per-host, so one stack definition yields a distinct tailnet node per host.
      ["TS_HOSTNAME"] = "\(module.name)-${HOST:?err}"
      ["TS_STATE_DIR"] = "/var/lib/tailscale"
      ["TS_USERSPACE"] = "true"
    }
  }
}

networks {
  ["default"] { name = module.name }
  [gateway.name] { name = gateway.name; `external` = true }
}

output {
  files {
    [secrets.configFile] = secrets.config("tailscale.containers", new Listing { "TS_AUTHKEY" })
  }
}
