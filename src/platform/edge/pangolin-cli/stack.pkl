// The Pangolin gateway every stack that needs one attaches to. This stack owns the
// shared network; consumers attach to it.
//
// olm always creates a kernel TUN device — it has no userspace/netstack tunnel mode the
// way tailscale has TS_USERSPACE — so NET_ADMIN and /dev/net/tun are load-bearing.
// `network_mode: host` is not: the tunnel comes up inside the container's own namespace,
// which is what keeps this a gateway into docker rather than into the host.
amends "@infra/Stack.pkl"

import "@infra/registry.pkl"
import "@infra/secrets.pkl"

local appVersion = "latest"
local gateway = registry.network.shared.pangolin_gw_001
local hosts = registry.endpoint.hostGroup

name = "pangolin-gw"

services {
  ["secrets"] = secrets.fnoxPerHost

  ["app"] {
    image = "docker.io/fosrl/pangolin-cli:\(appVersion)"
    restart = "unless-stopped"
    depends_on = secrets.ready
    networks { "default"; gateway.name }
    cap_add { "NET_ADMIN" }
    devices { "/dev/net/tun:/dev/net/tun" }
    data { ["state"] { target = "/root/.config/olm-client" } }
    // CLIENT_ID and CLIENT_SECRET arrive from 1Password through fnox, read from the deploying
    // host's item. HOST is not a secret: it comes from the deploy environment, so compose
    // still interpolates it here.
    environment {
      ["PANGOLIN_ENDPOINT"] = registry.endpoint.serviceGroup.pangolin.proxy.url
      // Linux caps interface names at 15 characters; olm-littlebuddy is exactly that.
      ["INTERFACE"] = "olm-${HOST:?err}"
    }
  }
}

networks {
  ["default"] { name = module.name }
  [gateway.name] { name = gateway.name; `external` = true }
}

output {
  files {
    [secrets.configFile] = secrets.hostConfig(
      new Listing { hosts.bill.alias; hosts.biggy.alias; hosts.paiki.alias; hosts.littlebuddy.alias; hosts.rick.alias },
      (host) -> "host.\(host)",
      new Listing { "CLIENT_ID"; "CLIENT_SECRET" })
  }
}
