amends "@infra/Stack.pkl"

import "@infra/registry.pkl"
import "@infra/collections.pkl" as col
import "@infra/secrets.pkl"

local version = "2.5.3"
local port = 3000
local sharedDB = registry.network.shared.db_001

name = "docuseal"

services {
  ["secrets"] = secrets.fnox

  ["app"] {
    image = "docuseal/docuseal:\(version)"
    restart = "on-failure:5"
    depends_on = secrets.ready
    networks { "default"; sharedDB.name }
    data { ["data"] { target = "/data/docuseal" } }
    // DATABASE_URL and SECRET_KEY_BASE arrive from 1Password through fnox. DATABASE_URL is
    // stored whole rather than assembled here: the provider injects values, and there is
    // no compose-level interpolation left to build a URL out of its parts.
    environment {
      ["PORT"] = port
      // Also the SSL switch: forces HTTPS redirects + absolute signing-link URLs.
      ["FORCE_SSL"] = "\(module.name).\(col.domain.ktbcloud)"
    }
    expose { port }
    ports { new { target = port; published = 18002; host_ip = col.ip.loopback } }
    labels {
      ["traefik.enable"] = "true"
      ["traefik.http.routers.app.rule"] = "Host('docuseal.internal')"
      ["traefik.http.services.app.loadbalancer.server.port"] = "3000"
    }
  }
}

networks {
  ["default"] { name = module.name }
  [sharedDB.name] { name = sharedDB.name; `external` = true }
}

output {
  files {
    [secrets.configFile] = secrets.config("docuseal", new Listing { "DATABASE_URL"; "SECRET_KEY_BASE" })
  }
}
