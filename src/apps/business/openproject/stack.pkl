// openproject: one Rails image run four ways (web, worker, scheduler and a one-shot
// seeder), plus a memcached cache, a collab (hocuspocus) server and a watchdog.
amends "@infra/Stack.pkl"

import "@compose/Compose.pkl"
import "@infra/registry.pkl"
import "@infra/collections.pkl" as col
import "@infra/secrets.pkl"

local appVersion = "17-slim"
local hocuspocusVersion = "17.5.1"
local autohealVersion = "1.2.0"
local memcachedVersion = "1.6-alpine"

local webPort = 8080
local collabPort = 1234

// The public subdomain 'openprj' differs from the stack name 'openproject'.
local sub = "openprj"
local cloudDomain = "\(sub).\(col.domain.ktbcloud)"
local internalDomain = "\(sub).\(col.domain.ktbinternal)"

local sharedDB = registry.network.shared.db_001

// DATABASE_URL, SECRET_KEY_BASE and OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__SECRET
// arrive from 1Password through fnox. DATABASE_URL is stored whole and must be spelled
// 'postgres://' not 'postgresql://': Ruby's uri gem does not pre-register the latter as
// hierarchical and rejects the user:pass@ part.
local appEnv = new Mapping<String, String> {
  ["OPENPROJECT_HTTPS"] = "true"
  ["OPENPROJECT_HSTS"] = "true"
  ["OPENPROJECT_RAILS__RELATIVE__URL__ROOT"] = ""
  ["RAILS_MIN_THREADS"] = "4"
  ["RAILS_MAX_THREADS"] = "8"
  // The image bundles libjemalloc but ships with it off; glibc malloc fragments badly
  // under Puma's threads, so enabling jemalloc reclaims ~20-35% of RSS.
  ["USE_JEMALLOC"] = "true"
  ["IMAP_ENABLED"] = "false"
  ["OPENPROJECT_HOST__NAME"] = cloudDomain
  // `web` lets the collab server's internal callback (http://web:8080) pass the host check.
  ["OPENPROJECT_ADDITIONAL__HOST__NAMES"] = "[\(cloudDomain), \(internalDomain), web]"
  ["OPENPROJECT_URL"] = "https://\(cloudDomain)"
  ["OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__URL"] = "wss://\(cloudDomain)/hocuspocus"
  ["OPENPROJECT_RAILS__CACHE__STORE"] = "memcache"
  ["OPENPROJECT_CACHE__MEMCACHE__SERVER"] = "cache:11211"
  ["OPENPROJECT_EE__HIDE__BANNERS"] = "true"
  ["OPENPROJECT_EE__MANAGER__VISIBLE"] = "false"
  ["OPENPROJECT_WELCOME__ON__HOMESCREEN"] = "false"
  ["OPENPROJECT_DISABLED__MODULES"] = ""
}

// The shared body of the four Rails services. Postgres is the shared cluster on this
// host, reached over shared__db_001; every Rails service needs it (the seeder runs the
// migrations). `web` owns the assets volume; the other three mount it.
local function rails(role: String): StackService = new {
  container_name = "\(module.name)-\(role)"
  hostname = role
  image = "openproject/openproject:\(appVersion)"
  restart = "unless-stopped"
  volumes {
    new { type = "volume"; source = "web_assets"; target = "/var/openproject/assets" }
    col.bind("./token/enterprise_token.rb", "/app/app/models/enterprise_token.rb")
  }
  environment = appEnv
  networks { "default"; sharedDB.name }
  depends_on = secrets.ready
}

local afterSeed = new Mapping<String, Compose.DependsOn> {
  ...secrets.ready
  ["cache"] { condition = "service_started" }
  ["seeder"] { condition = "service_started" }
}

name = "openproject"

services {
  ["secrets"] = secrets.fnox

  // Restarts any container labelled autoheal=true once its healthcheck fails.
  ["watchdog"] {
    image = "willfarrell/autoheal:\(autohealVersion)"
    restart = "unless-stopped"
    environment {
      ["AUTOHEAL_CONTAINER_LABEL"] = "autoheal"
      ["AUTOHEAL_START_PERIOD"] = "600"
      ["AUTOHEAL_INTERVAL"] = "30"
    }
    volumes { col.mounts.dockerSockRW }
  }

  ["cache"] {
    image = "memcached:\(memcachedVersion)"
    restart = "unless-stopped"
  }

  ["scheduler"] = (rails("scheduler")) {
    depends_on = afterSeed
    command { "./docker/prod/cron" }
  }

  ["collab"] {
    image = "openproject/hocuspocus:\(hocuspocusVersion)"
    restart = "unless-stopped"
    networks { "default"; sharedDB.name }
    depends_on = secrets.ready
    // Calls back into `web` over the private bridge (http, not the TLS hairpin); `web`
    // must be in OPENPROJECT_ADDITIONAL__HOST__NAMES. SECRET arrives from
    // infisical-secrets and holds the same value the Rails services read as
    // OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__SECRET.
    environment {
      ["OPENPROJECT_URL"] = "http://web:\(webPort)"
      ["OPENPROJECT_HTTPS"] = "true"
    }
    expose { collabPort }
    ports { new { target = collabPort; published = collabPort; host_ip = col.ip.loopback } }
  }

  // Runs migrations and seeds, then exits; the long-running services wait on it.
  ["seeder"] = (rails("seeder")) {
    command { "./docker/prod/seeder" }
    restart = "on-failure"
  }

  ["web"] = (rails("web")) {
    depends_on = afterSeed
    command { "./docker/prod/web" }
    data { ["assets"] { target = "/var/openproject/assets" } }
    volumes {
      col.bind("./token/enterprise_token.rb", "/app/app/models/enterprise_token.rb")
    }
    // One Puma worker instead of the default 2: a whole forked Rails process saved; low
    // concurrency here does not need two. Bump back up if web slows.
    environment {
      ...appEnv
      ["WEB_CONCURRENCY"] = "1"
    }
    labels { ["autoheal"] = "true" }
    healthcheck {
      test { "CMD"; "curl"; "-f"; "http://localhost:\(webPort)/health_checks/default" }
      interval = 10.s
      timeout = 3.s
      retries = 3
      start_period = 60.s
    }
    expose { webPort }
    ports { new { target = webPort; published = 18009; host_ip = col.ip.loopback } }
  }

  ["worker"] = (rails("worker")) {
    depends_on = afterSeed
    command { "./docker/prod/worker" }
  }
}

networks {
  ["default"] { name = module.name }
  [sharedDB.name] { name = sharedDB.name; `external` = true }
}

output {
  files {
    [secrets.configFile] = secrets.config("openproject", new Listing { "COLLAB_SERVER_SECRET"; "DATABASE_URL"; "OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__SECRET"; "SECRET"; "SECRET_KEY_BASE" })
  }
}
