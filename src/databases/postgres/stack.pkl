// The cluster's own identity is single-sourced at registry.endpoint.serviceGroup.postgres;
// change it there, not here. Consumers on this host reach it over shared__db_001;
// consumers on another host dial the published port at postgres.host.addr.
amends "@infra/Stack.pkl"

import "@infra/registry.pkl"
import "@infra/collections.pkl" as col
import "@infra/secrets.pkl"

local pg = registry.endpoint.serviceGroup.postgres
local sharedDB = registry.network.shared.db_001
local sharedTSGW = registry.network.shared.tailscale_gw_001
local version = "18"

name = "postgres"

services {
  ["secrets"] = secrets.provider("apps", "/postgres")

  ["db"] {
    // Other stacks already dial this name, so it is the registry's value.
    container_name = pg.container.name
    image = "postgres:\(version)"
    restart = "always"
    depends_on = secrets.ready
    networks { "default"; sharedDB.name; sharedTSGW.name }
    data { ["data"] { target = "/var/lib/postgresql" } }
    // POSTGRES_USER and POSTGRES_PASSWORD arrive from infisical-secrets.

    // Published to the host so containers in other stacks reach it through the gateway.
    ports { new { target = pg.container.port; published = pg.host.port; host_ip = col.ip.loopback } }
    healthcheck {
      // $$ escapes compose's own interpolation, so the shell in the container expands the
      // injected POSTGRES_USER rather than compose resolving it to nothing.
      test { "CMD-SHELL"; "pg_isready -U $$POSTGRES_USER -h localhost -d postgres" }
      interval = 5.s
      timeout = 5.s
      retries = 10
    }
  }
}

// shared__* networks are created out of band, so this stack attaches to them exactly like
// every consumer does; nothing here owns them.
networks {
  ["default"] { name = module.name }
  [sharedDB.name] { name = sharedDB.name; `external` = true }
  [sharedTSGW.name] { name = sharedTSGW.name; `external` = true }
}
