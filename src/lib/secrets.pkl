/// The secrets provider services a stack runs, the configs they read, and the depends_on
/// entry every service reading from one needs.
module infra.secrets

import "@compose/Stack.pkl"
import "@compose/Compose.pkl"
import "registry.pkl"
import "Stack.pkl" as infraStack

/// The infisical-secrets provider, left only for stacks with no 1Password item yet.
/// `project` is a key into `registry.infisical.project`; `path` is the bundle's folder,
/// written by the one stack that reads it.
function provider(project: registry.InfisicalProject, path: String): Stack.StackService = new {
  provider {
    type = "infisical-secrets"
    options {
      ["credentials-file"] = registry.path.file.infisical_creds
      ["domain"] = registry.infisical.address
      ["project-id"] = registry.infisical.project[project]
      ["env"] = "prod"
      ["path"] = path
      ["recursive"] = true
    }
  }
}

/// The docker-compose-fnox provider as a service, reading `config` relative to the stack
/// directory Komodo runs compose in.
///
/// Every secret in the config is injected as a plain environment variable into every
/// service that depends on the provider. Each one is read from the field of the same name
/// on a 1Password item in the `secrets` vault, so a secret must be stored under exactly
/// the name the container reads.
const function fnoxProvider(config: String): Stack.StackService = new {
  provider {
    type = "docker-compose-fnox"
    options {
      ["path_config_toml"] = config
      ["path_credentials_env"] = registry.path.file.onepassword_creds
      // fnox only warns on an unresolvable secret, which would start the stack without it.
      ["if_missing"] = "error"
    }
  }
}

/// fnox only resolves secrets from a config named fnox.toml, so a second provider in one
/// stack needs a config in a directory of its own.
const configFile = "fnox.toml"

const fnox: Stack.StackService = fnoxProvider(configFile)

/// A provider whose secrets differ per deploying host: fnox selects the profile named
/// after $HOST, which `hostConfig` writes one of per host.
const fnoxPerHost: Stack.StackService = (fnox) {
  provider { options { ["profile"] = "${HOST:?err}" } }
}

local function entries(item: String, names: Listing<String>): Listing<String> = new {
  for (name in names) {
    #"\#(name) = { provider = "onepassword", value = \#(new JsonRenderer {}.renderValue("\(item)/\(name)")) }"#
  }
}

local function toml(body: Listing<String>): FileOutput = new FileOutput {
  text = new Listing<String> {
    infraStack.header + "root = true"
    ""
    "[providers.onepassword]"
    #"type = "1password""#
    #"vault = "secrets""#
    ""
    ...body
  }.join("\n") + "\n"
}

/// fnox.toml resolving each of `names` from the field of the same name on `item`.
function config(item: String, names: Listing<String>): FileOutput = toml(new Listing {
  "[secrets]"
  ...entries(item, names)
})

/// fnox.toml with one profile per host, each resolving `names` from `itemFor(host)`.
function hostConfig(hosts: Listing<String>, itemFor: (String) -> String, names: Listing<String>): FileOutput =
  toml(new Listing {
    "[secrets]"
    for (host in hosts) {
      ""
      "[profiles.\(host).secrets]"
      ...entries(itemFor.apply(host), names)
    }
  })

/// A provider has no health of its own, so `started` is the only condition it satisfies.
const ready = new Mapping {
  ["secrets"] = new Compose.DependsOn { condition = "service_started" }
}
