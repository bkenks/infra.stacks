/// The infisical-secrets compose provider as a service, and the depends_on entry every
/// service reading from it needs.
///
/// Every secret at `path` is injected as a plain environment variable, under its own
/// Infisical name, into every service that depends on the provider. There is no
/// compose-level interpolation left to rename or compose values with, so a secret must
/// be stored under exactly the name the container reads.
module infra.secrets

import "@compose/Stack.pkl"
import "@compose/Compose.pkl"
import "registry.pkl"
import "Stack.pkl" as infraStack

/// `project` is a key into `registry.infisical.project`; `path` is the bundle's folder,
/// written by the one stack that reads it.
function provider(project: registry.InfisicalProject, path: String): Stack.StackService = new {
  provider {
    type = "infisical-secrets"
    options {
      ["credentials-file"] = registry.path.file.infisical_creds
      ["domain"] = registry.infisical.address
      ["project-id"] = registry.infisical.project[project]
      ["env"] = "prod"
      ["path"] = path
      ["recursive"] = true
    }
  }
}

/// The docker-compose-fnox provider as a service, reading the fnox.toml `fnoxConfig`
/// renders beside compose.yaml. No path is passed: Komodo runs compose in the stack
/// directory, which is where the provider looks for fnox.toml by default.
const fnox: Stack.StackService = new {
  provider {
    type = "docker-compose-fnox"
    options {
      ["path_credentials_env"] = registry.path.file.onepassword_creds
      // fnox only warns on an unresolvable secret, which would start the stack without it.
      ["if_missing"] = "error"
    }
  }
}

/// fnox.toml resolving each environment variable from an `item/field` reference in the
/// 1Password `secrets` vault.
function fnoxConfig(references: Mapping<String, String>): FileOutput = new FileOutput {
  text = new Listing<String> {
    infraStack.header + "root = true"
    ""
    "[providers.onepassword]"
    #"type = "1password""#
    #"vault = "secrets""#
    ""
    "[secrets]"
    for (name, reference in references) {
      #"\#(name) = { provider = "onepassword", value = \#(new JsonRenderer {}.renderValue(reference)) }"#
    }
  }.join("\n") + "\n"
}

/// A provider has no health of its own, so `started` is the only condition it satisfies.
const ready = new Mapping {
  ["secrets"] = new Compose.DependsOn { condition = "service_started" }
}
