# Copy to .env beside compose.yaml, edit, then `docker compose up -d`.
# Every value here has a default in compose.yaml — this file only overrides.

# Compose project name; also the container name prefix and the network name.
STACK_NAME=mediastack

# Owner of every directory the pre_start hooks create. Use your own account:
# `id -u` and `id -g` on the host.
PUID=1000
PGID=1000

TZ=America/New_York

# Per-app state. Small, back this up.
CONFIG_ROOT=./config

# The single shared tree: downloads and library on ONE filesystem, so imports
# hardlink instead of copying. Point this at the big disk or NAS mount.
DATA_ROOT=./data

# unless-stopped starts the stack on host boot. on-failure:5 does not.
RESTART_POLICY=unless-stopped

# Published host ports. Plex ignores its port (network_mode: host, :32400).
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
BAZARR_PORT=6767
SABNZBD_PORT=8080
SEERR_PORT=5055

# Image versions.
PROWLARR_VERSION=1.39.0
SONARR_VERSION=4.0.15
RADARR_VERSION=5.26.2
BAZARR_VERSION=1.5.4
SABNZBD_VERSION=4.5.4
PLEX_VERSION=1.43.3
SEERR_VERSION=v3.0.1
CONFIGARR_VERSION=1.28.0
DECLUTTARR_VERSION=v2.1.0

# Fresh Plex installs only: a claim token from https://plex.tv/claim, valid 4
# minutes. Blank it once the server is claimed.
PLEX_CLAIM=

# Only for the `tools` profile (configarr, decluttarr). Sonarr/Radarr →
# Settings → General → Security → API Key, after their first run.
SONARR_API_KEY=
RADARR_API_KEY=
