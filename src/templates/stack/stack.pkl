// STANDARD STACK TEMPLATE — copy this directory to start a new stack, set `name`, then
// delete every service and field you do not need.
//
// It is a real, rendering stack, so a library change that breaks it breaks this file and
// `mise run render` fails on the next commit.
//
// Services are keyed by role (pkl-compose Types.Role); the container is named
// <name>-<role>, and a `data` volume renders as <name>-<role>_<purpose>. Everything is
// written literally except the values that cross a stack boundary, which come from
// registry.pkl, and the secrets, which the infisical-secrets provider injects.
amends "@infra/Stack.pkl"

import "@infra/registry.pkl"
import "@infra/collections.pkl" as col
import "@infra/secrets.pkl"

local appVersion = "latest"
local dbVersion = "18"
local appPort = 8080
local dbUser = module.name
local dbName = module.name

name = "example"

services {
  // Fetches this stack's bundle and injects every secret in it, under its own Infisical
  // name, into each service that depends on it. The first argument is a KEY into
  // registry.infisical.project; the second is the folder inside it. A secret has to be
  // stored under exactly the name the container reads: a connection URL whole, not a
  // user and a password to join together.
  ["secrets"] = secrets.provider("apps", "/example")

  ["app"] {
    image = "ghcr.io/example/example:\(appVersion)"
    restart = "on-failure:5"

    // Published ports bind to loopback: apps are reached over the tailnet or through the
    // edge proxy, so a port that is not loopback-bound is a mistake, not a default.
    ports { new { target = appPort; published = 18000; host_ip = col.ip.loopback } }
    expose { appPort }

    data { ["data"] { target = "/data" } }

    depends_on {
      ...secrets.ready
      ["db"] { condition = "service_healthy" }
    }

    // DB_PASSWORD arrives from infisical-secrets. A value written here that the bundle
    // also carries is overwritten by the bundle's, which is how a literal default stays
    // overridable per host.
    environment {
      ["DB_HOST"] = "db"
      ["DB_NAME"] = dbName
      ["DB_USER"] = dbUser
      ["APP_URL"] = "https://\(module.name).\(col.domain.ktbinternal)"
    }

    healthcheck {
      test { "CMD"; "curl"; "-fsS"; "--max-time"; "2"; "http://localhost:\(appPort)" }
      interval = 30.s
      timeout = 10.s
      retries = 5
    }
  }

  // ── DB: dedicated Postgres ────────────────────────────────────────────────────
  // To use the SHARED cluster instead, delete this service and reach it by the level it
  // is on: same host, join registry.network.shared.db_001 and dial
  // registry.endpoint.serviceGroup.postgres.container.addr; another host, dial
  // registry.endpoint.serviceGroup.postgres.host.addr over the .internal zone.
  ["db"] {
    image = "docker.io/library/postgres:\(dbVersion)"
    restart = "on-failure:5"
    depends_on = secrets.ready
    expose { 5432 }
    data { ["data"] { target = "/var/lib/postgresql/data" } }
    // POSTGRES_PASSWORD arrives from infisical-secrets. `app` reads the same password as
    // DB_PASSWORD, so the bundle has to carry it under both names.
    environment {
      ["POSTGRES_USER"] = dbUser
      ["POSTGRES_DB"] = dbName
    }
    healthcheck {
      test { "CMD-SHELL"; "pg_isready --username=\(dbUser)" }
      interval = 5.s
      timeout = 10.s
      retries = 10
    }
  }
}

// The private bridge every service joins implicitly. `default` is compose's reserved
// key; the stack's name lands underneath it.
networks {
  ["default"] { name = module.name }
}
