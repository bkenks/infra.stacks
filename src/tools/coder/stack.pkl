amends "@infra/Stack.pkl"

import "@infra/collections.pkl" as col
import "@infra/secrets.pkl"

local coderVersion = "latest"
local coderFQDN = "coder.\(col.domain.ktbcloud)"
local coderURL = "https://\(coderFQDN)"
local port = 7080

// Workspace containers join this network by name, so the name is pinned rather than
// derived.
local workspacesNetwork = "coder-workspaces"

name = "coder"

services {
  ["secrets"] = secrets.provider("apps", "/coder")

  ["app"] {
    image = "ghcr.io/coder/coder:\(coderVersion)"
    depends_on {
      ...secrets.ready
      ["db"] { condition = "service_healthy" }
    }
    data { ["home"] { target = "/home/coder" } }
    volumes { col.mounts.dockerSockRW }
    networks { "default"; "workspaces" }
    ports { new { target = port; published = port; host_ip = col.ip.loopback } }
    // CODER_PG_CONNECTION_URL arrives from infisical-secrets.
    environment {
      ["CODER_HTTP_ADDRESS"] = "0.0.0.0:\(port)"
      ["CODER_ACCESS_URL"] = coderURL
      ["CODER_AGENT_URL"] = "http://\(module.name)-app:\(port)"
      // Traefik does not relay the custom `Upgrade: DERP` header; without this the
      // agent's tailnet relay never connects and every app 502s.
      ["CODER_DERP_FORCE_WEBSOCKETS"] = "true"
      ["CODER_WILDCARD_ACCESS_URL"] = "*.\(coderFQDN)"
    }
    user = "0:0"
  }

  ["db"] {
    image = "postgres:17"
    depends_on = secrets.ready
    // POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB arrive from infisical-secrets.
    data { ["data"] { target = "/var/lib/postgresql/data" } }
    healthcheck {
      test { "CMD-SHELL"; "pg_isready -U coder -d coder" }
      interval = 5.s
      timeout = 5.s
      retries = 5
    }
  }
}

networks {
  ["default"] { name = module.name }
  ["workspaces"] { name = workspacesNetwork }
}
