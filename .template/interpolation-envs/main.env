# Values used purely for ${...} interpolation in the compose body
# (compose/stack.yml + compose/secrets.yml). NOT injected into containers —
# that's what container-envs/*.env is for.

# Names (also select the matching container-envs/<name>.env files)
APP__NAME=  "app"

# DB login (non-secret; the password is the secret in /dev/shm). Uncomment when
# the stack has a database:
# APP__POSTGRES_USER=    replaceme.STACKNAME
# APP__POSTGRES_DBNAME=  replaceme.STACKNAME

# Container Restart Attempts On Failure (Exit Error)
APP__MAX_RESTART_ATTEMPS=  5
