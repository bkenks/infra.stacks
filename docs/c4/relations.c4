// Every cross-element edge, grouped by what it means. References are full FQNs
// because lexical scope does not cross a file boundary.
model {

    // ── Ingress ────────────────────────────────────────────────────────────
    // Gerbil owns the host ports; Traefik runs in gerbil's network namespace
    // (network_mode: service:gerbil) and every published route lands on it.
    operator  -> www "browses"
    household -> www "browses"

    www -[proxies]-> selfHosted.gateway.wgOrc "HTTPS :443, HTTP :80"
    selfHosted.gateway.wgOrc  -[proxies]-> selfHosted.gateway.rProxy "shares the network namespace"
    selfHosted.gateway.pangolin -> selfHosted.gateway.wgOrc "pushes remote config" { technology "HTTP :3001" }
    selfHosted.gateway.rProxy -> selfHosted.gateway.pangolin "authorizes each request" { technology "Badger middleware" }
    selfHosted.gateway.rProxy -> saas.dns "solves ACME DNS-01" { technology "ACME" }

    // Remote sites dial out to the orchestrator; nothing dials in.
    selfHosted.gateway.wgAgent -[overlay]-> selfHosted.gateway.wgOrc "WireGuard :51820"

    // ── Published routes ───────────────────────────────────────────────────
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.idp.authentik          "authentik.ktbcloud.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.secCodeForge.forgejo   "fj.ktbcloud.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.ci.server              "peck.ktbcloud.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.prjMan.openPrj         "openprj.ktbcloud.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.docsign.docuseal       "docuseal.ktbcloud.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.secretsMan.infisical   "infisical.ktbinternal.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.containerOrc.komoC     "komo.ktbinternal.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.agentGw.komodoMcp      "komodo-mcp.ktbinternal.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.docArc.paperless       "paper.ktbinternal.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.mediaLib.seerr         "seerr.ktbinternal.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.mediaLib.sonarr        "sonarr.ktbinternal.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.mediaLib.radarr        "radarr.ktbinternal.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.mediaLib.prowlarr      "prowlarr.ktbinternal.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.mediaLib.bazarr        "bazarr.ktbinternal.com"
    selfHosted.gateway.rProxy -[proxies]-> selfHosted.mediaLib.sabnzbd       "sabnzbd.ktbinternal.com"

    // ── Overlay network ────────────────────────────────────────────────────
    selfHosted.overlayNet.agent -[overlay]-> saas.tailnetCoord "joins the tailnet"
    selfHosted.overlayNet.agent -[overlay]-> selfHosted.idp.db "exposes on the tailnet" { technology "shared__ts-gateway" }
    selfHosted.overlayNet.agent -[overlay]-> selfHosted.secretsMan.infisical "exposes on the tailnet" { technology "shared__ts-gateway" }

    // ── Identity ───────────────────────────────────────────────────────────
    selfHosted.dashboard.homarr -[oidc]-> selfHosted.idp.authentik "authenticates users"
    selfHosted.ci.server -[oidc]-> selfHosted.secCodeForge.forgejo "OAuth2 login and repository access"

    // ── Secrets ────────────────────────────────────────────────────────────
    // Every stack declares a `secrets` compose service using the
    // infisical-secrets provider against http://controlplane.internal:18043.
    // Modelled once per stack, not once per container.
    // Project `infra` (86324d9b…):
    selfHosted.gateway      -[secrets]-> selfHosted.secretsMan.infisical "/traefik"
    selfHosted.idp          -[secrets]-> selfHosted.secretsMan.infisical "/authentik"
    selfHosted.containerOrc -[secrets]-> selfHosted.secretsMan.infisical "/komodo"
    selfHosted.secCodeForge -[secrets]-> selfHosted.secretsMan.infisical "/forgejo"
    selfHosted.ci           -[secrets]-> selfHosted.secretsMan.infisical "/woodpecker"
    selfHosted.dashboard    -[secrets]-> selfHosted.secretsMan.infisical "/homarr"
    selfHosted.agentGw      -[secrets]-> selfHosted.secretsMan.infisical "/komodo-mcp"
    selfHosted.dataBak      -[secrets]-> selfHosted.secretsMan.infisical "/zerobyte"
    selfHosted.dbBak        -[secrets]-> selfHosted.secretsMan.infisical "/databasus"
    selfHosted.overlayNet   -[secrets]-> selfHosted.secretsMan.infisical "/tailscale/containers"
    // Project `apps` (2f0eb3d1…):
    selfHosted.gateway  -[secrets]-> selfHosted.secretsMan.infisical "/pangolin"
    selfHosted.sharedState.sharedDB -[secrets]-> selfHosted.secretsMan.infisical "/postgres"
    selfHosted.prjMan   -[secrets]-> selfHosted.secretsMan.infisical "/openproject"
    selfHosted.docsign  -[secrets]-> selfHosted.secretsMan.infisical "/docuseal"
    selfHosted.docArc   -[secrets]-> selfHosted.secretsMan.infisical "/paperless"
    selfHosted.phovid   -[secrets]-> selfHosted.secretsMan.infisical "/immich"
    selfHosted.mediaLib -[secrets]-> selfHosted.secretsMan.infisical "/stream"
    // Project `frappe` (12ed25dd…):
    selfHosted.erp      -[secrets]-> selfHosted.secretsMan.infisical "/"

    // Ansible is the one reader that is not a stack: it pulls each host's newt
    // enrolment pair before installing the unit.
    selfHosted.configMgmt.ansible -[secrets]-> selfHosted.secretsMan.infisical "/hosts/<host>/newt"

    // ── Configuration management ───────────────────────────────────────────
    // Ansible runs from the operator's workstation. It owns the bare-metal layer
    // and the control-plane cold start; Komodo owns everything after that.
    operator -> selfHosted.configMgmt.ansible "runs playbooks"
    // The one credential Infisical cannot hold is its own: Ansible plants each host's
    // machine identity from 1Password, so the compose provider has something to log in with.
    selfHosted.configMgmt.ansible -> saas.passwdMan "reads machine identities and the tailnet auth key"
    selfHosted.configMgmt.ansible -> saas.priCodeForge "clones infra.stacks" { technology "SSH" }

    selfHosted.configMgmt.ansible -[deploys]-> selfHosted.overlayNet.agent "enrols the host in the tailnet"
    selfHosted.configMgmt.ansible -[deploys]-> selfHosted.gateway.wgAgent "installs the newt systemd unit"
    selfHosted.configMgmt.ansible -[deploys]-> selfHosted.containerOrc.komoP "installs the periphery systemd unit"

    // Cold-start order: the restore tier comes up first so a bare host can restore
    // Infisical's volume before Infisical parses it.
    selfHosted.configMgmt.ansible -[deploys]-> selfHosted.dbBak.databasus "restore gate"
    selfHosted.configMgmt.ansible -[deploys]-> selfHosted.dataBak.zerobyte "restore gate"
    selfHosted.configMgmt.ansible -[deploys]-> selfHosted.secretsMan.infisical "bootstraps the control plane"
    selfHosted.configMgmt.ansible -[deploys]-> selfHosted.containerOrc.komoC "bootstraps the control plane"

    // ── Orchestration ──────────────────────────────────────────────────────
    selfHosted.containerOrc.komoC -[deploys]-> selfHosted.containerOrc.komoP "TLS :8120, pinned core public key"
    selfHosted.containerOrc.komoP -[deploys]-> selfHosted.sharedState.dockerVolumes "creates and manages"
    selfHosted.containerOrc.komoC -> selfHosted.secCodeForge.forgejo "syncs stack definitions"
    selfHosted.containerOrc.komoC -> saas.alerting "sends alerts"
    selfHosted.agentGw.komodoMcp -> selfHosted.containerOrc.komoC "Komodo API"
    selfHosted.ci.agent -> selfHosted.ci.server "polls for work" { technology "gRPC :9000" }

    // ── State ──────────────────────────────────────────────────────────────
    selfHosted.prjMan.openPrj   -[sql]-> selfHosted.sharedState.sharedDB
    selfHosted.docsign.docuseal -[sql]-> selfHosted.sharedState.sharedDB

    selfHosted.idp.authentik           -[sql]-> selfHosted.idp.db
    selfHosted.idp.worker              -[sql]-> selfHosted.idp.db
    selfHosted.secretsMan.infisical    -[sql]-> selfHosted.secretsMan.db
    selfHosted.secretsMan.infisical    -> selfHosted.secretsMan.redis "queues and caches"
    selfHosted.secCodeForge.forgejo    -[sql]-> selfHosted.secCodeForge.db
    selfHosted.containerOrc.komoC      -> selfHosted.containerOrc.db "reads and writes"
    selfHosted.docArc.paperless        -[sql]-> selfHosted.docArc.db
    selfHosted.docArc.paperless        -> selfHosted.docArc.broker "queues tasks"
    selfHosted.docArc.paperless        -> selfHosted.docArc.gotenberg "converts to PDF"
    selfHosted.docArc.paperless        -> selfHosted.docArc.tika "extracts text"
    selfHosted.phovid.immich           -[sql]-> selfHosted.phovid.db
    selfHosted.phovid.immich           -> selfHosted.phovid.redis "queues jobs"
    selfHosted.phovid.immich           -> selfHosted.phovid.machineLearning "runs inference"

    selfHosted.erp.erpnext -> selfHosted.erp.db "reads and writes" { technology "MariaDB" }
    selfHosted.erp.erpnext -> selfHosted.erp.redisCache "caches"
    selfHosted.erp.erpnext -> selfHosted.erp.redisQueue "queues jobs"

    selfHosted.mediaLib.prowlarr -> selfHosted.mediaLib.sonarr "feeds indexers"
    selfHosted.mediaLib.prowlarr -> selfHosted.mediaLib.radarr "feeds indexers"
    selfHosted.mediaLib.sonarr   -> selfHosted.mediaLib.sabnzbd "queues downloads"
    selfHosted.mediaLib.radarr   -> selfHosted.mediaLib.sabnzbd "queues downloads"
    selfHosted.mediaLib.bazarr   -> selfHosted.mediaLib.sonarr "reads the library"
    selfHosted.mediaLib.bazarr   -> selfHosted.mediaLib.radarr "reads the library"
    selfHosted.mediaLib.seerr    -> selfHosted.mediaLib.sonarr "requests series"
    selfHosted.mediaLib.seerr    -> selfHosted.mediaLib.radarr "requests films"

    // ── Files ──────────────────────────────────────────────────────────────
    selfHosted.fileExp.fbq -> selfHosted.sharedState.sharedFiles "serves the tree"
    selfHosted.gameServers.terraria -> selfHosted.sharedState.sharedFiles "stores its world"

    // ── Backup ─────────────────────────────────────────────────────────────
    // Databasus reaches each target over the .internal zone; Zerobyte reads the
    // host volume tree directly through a bind mount.
    selfHosted.dbBak.databasus -[backup]-> selfHosted.sharedState.sharedDB
    selfHosted.dbBak.databasus -[backup]-> selfHosted.idp.db
    selfHosted.dbBak.databasus -[backup]-> selfHosted.secretsMan.db
    selfHosted.dbBak.databasus -[backup]-> selfHosted.secCodeForge.db
    selfHosted.dbBak.databasus -[backup]-> selfHosted.containerOrc.db
    selfHosted.dbBak.databasus -[backup]-> selfHosted.docArc.db
    selfHosted.dbBak.databasus -[backup]-> selfHosted.phovid.db
    selfHosted.dbBak.databasus -[backup]-> selfHosted.erp.db
    selfHosted.dataBak.zerobyte -[backup]-> selfHosted.sharedState.dockerVolumes

    // ── Email ──────────────────────────────────────────────────────────────
    selfHosted.secretsMan.infisical -> saas.email "SMTP :465"
    selfHosted.gateway.pangolin     -> saas.email "SMTP :465"
}
