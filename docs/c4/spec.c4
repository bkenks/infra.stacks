specification {
    // Tags ——————————————————————————————————————————
    // Capability grouping. An element carries at most one of these.
    tag orchestration
    tag networking
    tag observability
    tag communications
    tag secrets
    tag backup-and-recovery
    tag identity-and-access

    tag development
    tag business
    tag media
    tag gaming
    tag files

    // Cross-cutting properties. An element may carry any number.
    tag workload       // user-facing: the household consumes it, not the fleet
    tag public         // published on ktbcloud.com — reachable without the tailnet
    tag stateful       // holds data a backup coordinator must capture

    // Element kinds —————————————————————————————————
    element actor {
        notation "Person"
        style { shape person; color secondary }
    }
    element internet {
        notation "Public Internet"
        style { shape queue; color muted }
    }

    // Ecosystems — the top layer. Every capability sits in exactly one.
    // The axis is what I can model, not where the hardware sits: `infra` holds
    // the capabilities I decompose into processes, `platform` the ones I cannot.
    // Where a capability physically runs is deployment.c4's answer, not this layer's.
    element infra {
        notation "Infrastructure ecosystem"
        style { shape rectangle; color gray }
    }
    element platform {
        notation "Platform ecosystem"
        style { shape rectangle; color muted; border dashed }
    }

    // Capabilities — the middle layer. A capability under `platform` is opaque
    // and has no children; under `infra` it decomposes into processes.
    element capability {
        notation "Capability"
        style { shape rectangle; color slate }
    }

    // Processes — the leaf layer. What actually runs.
    element process {
        notation "Process"
        style { shape component; color blue }
    }
    element datastore {
        #stateful
        notation "File tree"
        style { shape storage; color muted }
    }
    element database {
        #stateful
        notation "Database"
        style { shape storage; color green }
    }

    // Relationship kinds ————————————————————————————
    // Kinds exist so a view can drop a whole family of edges in one predicate.
    // Every stack reads secrets from Infisical, so #secrets alone is ~20 edges
    // converging on one node — the landscape is unreadable without excluding it.
    relationship secrets { technology "Infisical"; line dotted; color muted }
    relationship oidc    { technology "OIDC"; line dashed; color secondary }
    relationship proxies { technology "HTTPS" }
    relationship sql     { technology "PostgreSQL"; line dashed }
    relationship backup  { line dotted; head diamond; color amber }
    relationship overlay { technology "WireGuard"; line dashed; color sky }
    relationship deploys { color green }

    // Deployment node kinds —————————————————————————
    deploymentNode environment { notation "Environment"; style { color gray } }
    deploymentNode site        { notation "Site" }
    deploymentNode host        { notation "Host"; style { shape rectangle } }
    deploymentNode device      { notation "Device"; style { shape storage } }
}
