// Fleet placement. Sourced from infra.registry/src/registry.jsonnet and
// infra.ansible/inventory. files/komodo_config/sync.toml is a stale local copy —
// do not treat it as authoritative for which host runs what.
//
// Newt and Komodo Periphery are installed by infra.ansible on `ubuntu_servers`,
// which is every host below except the NAS — hence the repetition.
deployment {

    environment prod "Production" {

        site cloud "Cloud VPS" {

            host rick "rick" {
                description "Vultr VPS. The control plane: the only host in registry.jsonnet roles.controlPlane."

                instanceOf selfHosted.gateway
                instanceOf selfHosted.idp
                instanceOf selfHosted.secretsMan
                instanceOf selfHosted.dashboard
                instanceOf selfHosted.dbBak
                instanceOf selfHosted.dataBak

                instanceOf selfHosted.overlayNet.agent
                instanceOf selfHosted.containerOrc.komoC
                instanceOf selfHosted.containerOrc.komoP
            }

            host maboi "maboi" {
                description "Hetzner Cloud cpx11, ash. Registered with Komodo, runs no stacks."

                instanceOf selfHosted.gateway.wgAgent
                instanceOf selfHosted.overlayNet.agent
                instanceOf selfHosted.containerOrc.komoP
            }
        }

        site homelab "Home Lab" {

            host littlebuddy "littlebuddy" {
                description "HP EliteDesk 705."

                instanceOf selfHosted.sharedState.sharedDB
                instanceOf selfHosted.secCodeForge
                instanceOf selfHosted.ci
                instanceOf selfHosted.agentGw
                instanceOf selfHosted.prjMan
                instanceOf selfHosted.docsign
                instanceOf selfHosted.docArc

                instanceOf selfHosted.gateway.wgAgent
                instanceOf selfHosted.overlayNet.agent
                instanceOf selfHosted.containerOrc.komoP
            }

            host biggy "biggy" {
                description "HP ProDesk 400."

                instanceOf selfHosted.fileExp
                instanceOf selfHosted.gameServers
                instanceOf selfHosted.sharedState.sharedFiles

                instanceOf selfHosted.gateway.wgAgent
                instanceOf selfHosted.overlayNet.agent
                instanceOf selfHosted.containerOrc.komoP
            }

            host bill "bill" {
                description "HP EliteDesk 705."

                instanceOf selfHosted.erp

                instanceOf selfHosted.gateway.wgAgent
                instanceOf selfHosted.overlayNet.agent
                instanceOf selfHosted.containerOrc.komoP
            }

            host paiki "paiki" {
                description "Beelink S13 Mini PC."

                instanceOf selfHosted.phovid
                instanceOf selfHosted.mediaLib

                instanceOf selfHosted.gateway.wgAgent
                instanceOf selfHosted.overlayNet.agent
                instanceOf selfHosted.containerOrc.komoP
            }

            device nas "snaszy" {
                description "Synology NAS. Not Komodo-managed; holds /volume1/backups and /volume1/docker."
            }
        }
    }
}
