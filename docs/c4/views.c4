views {

    // ── Landscape ──────────────────────────────────────────────────────────
    view index {
        title 'Landscape'
        description 'Every ecosystem and the capabilities inside it, with the secret-distribution edges suppressed.'

        include *
        include selfHosted.*, saas.*
        exclude * -> * where kind is secrets

        global style base
        autoLayout LeftRight
    }

    view secrets {
        title 'Secret Distribution'
        description 'The edges index hides: every stack reads its bundle from Infisical.'

        include selfHosted.secretsMan
        include selfHosted.secretsMan.*
        include * -> selfHosted.secretsMan

        global style base
        autoLayout LeftRight
    }

    // ── Cross-cutting ──────────────────────────────────────────────────────
    view ingress {
        title 'Ingress Path'
        description 'How a request reaches a workload. Gerbil owns the host ports; Traefik shares its namespace.'

        include www, operator, household
        include selfHosted.gateway, selfHosted.gateway.*
        include selfHosted.gateway.rProxy ->
        include saas.dns

        global style base
        autoLayout LeftRight
    }

    view identity {
        title 'Identity'
        description 'What depends on single sign-on.'

        include selfHosted.idp, selfHosted.idp.*
        include * -> selfHosted.idp.authentik
        include selfHosted.ci, selfHosted.ci.*
        include * -> selfHosted.secCodeForge.forgejo

        global style base
    }

    view state {
        title 'State and Backup'
        description 'Everything a backup coordinator captures, and which one captures it.'

        include * where tag is #stateful
        include selfHosted.dbBak, selfHosted.dbBak.*
        include selfHosted.dataBak, selfHosted.dataBak.*
        include selfHosted.dbBak.databasus -> *
        include selfHosted.dataBak.zerobyte -> *

        global style base
        autoLayout LeftRight
    }

    view apps {
        title 'Workloads'
        description 'The user-facing catalogue.'

        include * where tag is #workload
        // The counterparties, so the catalogue shows dependencies and not just boxes.
        include selfHosted.gateway, selfHosted.sharedState.sharedDB, selfHosted.sharedState.sharedFiles, selfHosted.secretsMan

        global style base
    }

    // ── Per-system drill-down ──────────────────────────────────────────────
    view gatewayDetail of selfHosted.gateway {
        title 'Gateway'
        include *
        include -> selfHosted.gateway.rProxy ->
        global style base
    }

    view idpDetail of selfHosted.idp {
        title 'Identity Provider'
        include *
        include -> selfHosted.idp.authentik ->
        global style base
    }

    view secretsManDetail of selfHosted.secretsMan {
        title 'Secrets Manager'
        include *
        global style base
    }

    view containerOrcDetail of selfHosted.containerOrc {
        title 'Container Orchestrator'
        include *
        include -> selfHosted.containerOrc.komoC ->
        global style base
    }

    view forgeDetail of selfHosted.secCodeForge {
        title 'Secondary Code Forge'
        include *
        include -> selfHosted.secCodeForge.forgejo ->
        global style base
    }

    view ciDetail of selfHosted.ci {
        title 'Continuous Integration'
        include *
        include -> selfHosted.ci.server ->
        global style base
    }

    view docArcDetail of selfHosted.docArc {
        title 'Document Archive'
        include *
        global style base
    }

    view phovidDetail of selfHosted.phovid {
        title 'Personal Photo Storage'
        include *
        global style base
    }

    view mediaLibDetail of selfHosted.mediaLib {
        title 'Media Library'
        include *
        global style base
    }

    // ── Flows ──────────────────────────────────────────────────────────────
    dynamic view flowRequest {
        variant sequence
        title 'Serving an authenticated request'

        www -> selfHosted.gateway.wgOrc 'GET openprj.ktbcloud.com'
        selfHosted.gateway.wgOrc -> selfHosted.gateway.rProxy 'forwards on the shared namespace'
        selfHosted.gateway.rProxy -> selfHosted.gateway.pangolin 'badger: is this session allowed?'
        selfHosted.gateway.rProxy <- selfHosted.gateway.pangolin 'allow'
        selfHosted.gateway.rProxy -> selfHosted.prjMan.openPrj 'proxies'
        selfHosted.prjMan.openPrj -> selfHosted.sharedState.sharedDB 'query'
        selfHosted.prjMan.openPrj <- selfHosted.sharedState.sharedDB 'rows'
        selfHosted.gateway.rProxy <- selfHosted.prjMan.openPrj '200 OK'
        www <- selfHosted.gateway.rProxy '200 OK'
    }

    dynamic view flowSecrets {
        variant sequence
        title 'How a stack gets its secrets'
        description 'The pattern every stack shares — the compose provider runs before the app starts.'

        selfHosted.containerOrc.komoP -> selfHosted.docsign.docuseal 'docker compose up'
        selfHosted.docsign.docuseal -> selfHosted.secretsMan.infisical 'machine identity login, then GET /docuseal'
        selfHosted.docsign.docuseal <- selfHosted.secretsMan.infisical 'secret bundle'
        selfHosted.docsign.docuseal -> selfHosted.sharedState.sharedDB 'connects with the injected credentials'
    }

    dynamic view flowDeploy {
        variant sequence
        title 'Deploying a stack'

        operator -> selfHosted.secCodeForge.forgejo 'git push'
        selfHosted.containerOrc.komoC -> selfHosted.secCodeForge.forgejo 'syncs stack definitions'
        selfHosted.containerOrc.komoC -> selfHosted.containerOrc.komoP 'deploy'
        selfHosted.containerOrc.komoP -> selfHosted.secretsMan.infisical 'provider fetches the bundle'
        selfHosted.containerOrc.komoP <- selfHosted.secretsMan.infisical 'secrets'
        selfHosted.containerOrc.komoC <- selfHosted.containerOrc.komoP 'result'
        selfHosted.containerOrc.komoC -> saas.alerting 'alerts on failure'
    }

    // ── Deployment ─────────────────────────────────────────────────────────
    deployment view fleet {
        title 'Fleet'
        description 'Seven hosts. Newt and Komodo Periphery run on all six ubuntu_servers.'

        // Level by level, not `prod.**` — `.**` keeps only descendants that already
        // have an edge, which silently drops Newt and Periphery on the quiet hosts.
        include prod, prod.*
        include prod.cloud.*, prod.homelab.*
        include prod.cloud.rick.*, prod.cloud.maboi.*
        include prod.homelab.littlebuddy.*, prod.homelab.biggy.*
        include prod.homelab.bill.*, prod.homelab.paiki.*

        autoLayout LeftRight
    }

    deployment view controlplane {
        title 'Control Plane'
        description 'rick, and everything it reaches.'

        // `.*` and not `.**` — `.**` drops any instance whose only edges leave the host,
        // which would hide Komodo Periphery.
        include prod.cloud.rick
        include prod.cloud.rick.*
    }
}
