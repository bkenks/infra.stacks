views {

    // ── Landscape ──────────────────────────────────────────────────────────
    view index {
        title 'Landscape'
        description 'Every system, with the secret-distribution edges suppressed.'

        include *
        exclude * -> * where kind is secrets

        global style base
        autoLayout LeftRight
    }

    view secrets {
        title 'Secret Distribution'
        description 'The edges index hides: every stack reads its bundle from Infisical.'

        include secretsMan
        include secretsMan.*
        include * -> secretsMan

        global style base
        autoLayout LeftRight
    }

    // ── Cross-cutting ──────────────────────────────────────────────────────
    view ingress {
        title 'Ingress Path'
        description 'How a request reaches a workload. Gerbil owns the host ports; Traefik shares its namespace.'

        include www, operator, household
        include gateway, gateway.*
        include gateway.rProxy ->
        include dns, dns.*

        global style base
        autoLayout LeftRight
    }

    view identity {
        title 'Identity'
        description 'What depends on single sign-on.'

        include idp, idp.*
        include * -> idp.authentik
        include ci, ci.*
        include * -> secCodeForge.forgejo

        global style base
    }

    view state {
        title 'State and Backup'
        description 'Everything a backup coordinator captures, and which one captures it.'

        include * where tag is #stateful
        include dbBak, dbBak.*
        include dataBak, dataBak.*
        include dbBak.databasus -> *
        include dataBak.zerobyte -> *

        global style base
        autoLayout LeftRight
    }

    view apps {
        title 'Workloads'
        description 'The user-facing catalogue.'

        include * where kind is userSystem
        // The counterparties, so the catalogue shows dependencies and not just boxes.
        include gateway, sharedDB, sharedFiles, secretsMan

        global style base
    }

    // ── Per-system drill-down ──────────────────────────────────────────────
    view gatewayDetail of gateway {
        title 'Gateway'
        include *
        include -> gateway.rProxy ->
        global style base
    }

    view idpDetail of idp {
        title 'Identity Provider'
        include *
        include -> idp.authentik ->
        global style base
    }

    view secretsManDetail of secretsMan {
        title 'Secrets Manager'
        include *
        global style base
    }

    view containerOrcDetail of containerOrc {
        title 'Container Orchestrator'
        include *
        include -> containerOrc.komoC ->
        global style base
    }

    view forgeDetail of secCodeForge {
        title 'Secondary Code Forge'
        include *
        include -> secCodeForge.forgejo ->
        global style base
    }

    view ciDetail of ci {
        title 'Continuous Integration'
        include *
        include -> ci.server ->
        global style base
    }

    view docArcDetail of docArc {
        title 'Document Archive'
        include *
        global style base
    }

    view phovidDetail of phovid {
        title 'Personal Photo Storage'
        include *
        global style base
    }

    view mediaLibDetail of mediaLib {
        title 'Media Library'
        include *
        global style base
    }

    // ── Flows ──────────────────────────────────────────────────────────────
    dynamic view flowRequest {
        variant sequence
        title 'Serving an authenticated request'

        www -> gateway.wgOrc 'GET openprj.ktbcloud.com'
        gateway.wgOrc -> gateway.rProxy 'forwards on the shared namespace'
        gateway.rProxy -> gateway.pangolin 'badger: is this session allowed?'
        gateway.rProxy <- gateway.pangolin 'allow'
        gateway.rProxy -> prjMan.openPrj 'proxies'
        prjMan.openPrj -> sharedDB 'query'
        prjMan.openPrj <- sharedDB 'rows'
        gateway.rProxy <- prjMan.openPrj '200 OK'
        www <- gateway.rProxy '200 OK'
    }

    dynamic view flowSecrets {
        variant sequence
        title 'How a stack gets its secrets'
        description 'The pattern every stack shares — the compose provider runs before the app starts.'

        containerOrc.komoP -> docsign.docuseal 'docker compose up'
        docsign.docuseal -> secretsMan.infisical 'machine identity login, then GET /docuseal'
        docsign.docuseal <- secretsMan.infisical 'secret bundle'
        docsign.docuseal -> sharedDB 'connects with the injected credentials'
    }

    dynamic view flowDeploy {
        variant sequence
        title 'Deploying a stack'

        operator -> secCodeForge.forgejo 'git push'
        containerOrc.komoC -> secCodeForge.forgejo 'syncs stack definitions'
        containerOrc.komoC -> containerOrc.komoP 'deploy'
        containerOrc.komoP -> secretsMan.infisical 'provider fetches the bundle'
        containerOrc.komoP <- secretsMan.infisical 'secrets'
        containerOrc.komoC <- containerOrc.komoP 'result'
        containerOrc.komoC -> alerting.pushover 'alerts on failure'
    }

    // ── Deployment ─────────────────────────────────────────────────────────
    deployment view fleet {
        title 'Fleet'
        description 'Seven hosts. Newt and Komodo Periphery run on all six ubuntu_servers.'

        // Level by level, not `prod.**` — `.**` keeps only descendants that already
        // have an edge, which silently drops Newt and Periphery on the quiet hosts.
        include prod, prod.*
        include prod.cloud.*, prod.homelab.*
        include prod.cloud.rick.*, prod.cloud.maboi.*
        include prod.homelab.littlebuddy.*, prod.homelab.biggy.*
        include prod.homelab.bill.*, prod.homelab.paiki.*

        autoLayout LeftRight
    }

    deployment view controlplane {
        title 'Control Plane'
        description 'rick, and everything it reaches.'

        // `.*` and not `.**` — `.**` drops any instance whose only edges leave the host,
        // which would hide Komodo Periphery.
        include prod.cloud.rick
        include prod.cloud.rick.*
    }
}
